# ── AuthenticV Production Environment Variables (Vercel) ───────────────

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Database (Prisma & Direct PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── Anthropic AI Engine ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── CamPay Mobile Money Gateway ─────────────────────────────────────────
CAMPAY_APP_USERNAME=your_username
CAMPAY_APP_PASSWORD=your_password
CAMPAY_PERMANENT_TOKEN=your_permanent_token
CAMPAY_WEBHOOK_SECRET=your_webhook_secret
CAMPAY_API_BASE=https://campay.net/api

# ── Application URLs ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://authenticv.app
CRON_SECRET=your_cron_secret_token
